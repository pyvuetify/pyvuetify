   "source": [
    "import pyvuetify as v\n",
    "\n",
    "# Nested widgets\n",
    "alert = v.Alert(\n",
    "    text=\"Alert with chips inside\",\n",
    "    children=[\n",
    "        v.Chip(children=\"Tag 1\", color=\"blue\"),\n",
    "        v.Chip(children=\"Tag 2\", color=\"red\"),\n",
    "    ],\n",
    ")\n",
    "alert"
   ]
