"""The pyvuetify auto-generated components package."""

import importlib as _importlib

__all__ = [
{%- for module_name in module_names %}
    "{{ module_name }}",
{%- endfor %}
]

_MODULE_NAMES = frozenset(__all__)


def __getattr__(name: str):
    if name in _MODULE_NAMES:
        _mod = _importlib.import_module(f".{name}", package=__name__)
        _cls = getattr(_mod, name)
        globals()[name] = _cls  # cache so future lookups bypass __getattr__
        return _cls
    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")

